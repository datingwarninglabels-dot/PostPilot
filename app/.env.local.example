# Supabase project — Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only Supabase Auth user allowed to sign in to this app
ADMIN_EMAIL=

# Which provider drafts post copy: "openai" (default) or "gemini"
AI_PROVIDER=openai

# OpenAI API key, for drafting post copy (used when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini API key, for drafting post copy (used when AI_PROVIDER=gemini)
# console: https://aistudio.google.com/apikey — free tier, no credit card required
GEMINI_API_KEY=

# Filled in during Phase 2 (Meta developer app + OAuth). Facebook Pages only —
# Instagram is a separate Meta app/product, see INSTAGRAM_APP_ID below.
META_APP_ID=
META_APP_SECRET=

# Separate "Instagram API with Instagram Login" Meta app — its own App ID/
# Secret, distinct from META_APP_ID/SECRET above (App Dashboard > Instagram >
# API setup with Instagram login > Business login settings).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Filled in during Phase 2 (TikTok developer app)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Base URL used to build OAuth redirect URIs (Meta/Instagram/TikTok). HTTPS
# even on localhost — Instagram's "Instagram API with Instagram Login"
# product rejects http:// redirect URIs outright (unlike Facebook/TikTok,
# which accept either). Dev server runs via `next dev --experimental-https`
# (self-signed cert) to match — see .claude/launch.json at the session root.
APP_BASE_URL=https://localhost:3001

# AES-256-GCM key (32 random bytes, base64) for encrypting platform_connections
# access/refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Shared secret the cron publisher checks via `Authorization: Bearer <value>`.
# Matches the header Vercel Cron sends once deployed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
